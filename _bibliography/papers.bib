}

@inproceedings{d822eb12ff00466fabb72976cee1e82f,
abbr={DAFx},
title = "Differentiable All-pass Filters for Phase Response Estimation and Automatic Signal Alignment",
abstract = "Virtual analog (VA) audio effects are increasingly based on neural networks and deep learning frameworks. Due to the underlying black-box methodology, a successful model will learn to approximate the data it is presented, including potential errors such as latency and audio dropouts as well as non-linear characteristics and frequency-dependent phase shifts produced by the hardware. The latter is of particular interest as the learned phase-response might cause unwanted audible artifacts when the effect is used for creative processing techniques such as dry-wet mixing or parallel compression. To overcome these artifacts we propose differentiable signal processing tools and deep optimization structures for automatically tuning all-pass filters to predict the phase response of different VA simulations, and align processed signals that are out of phase. The approaches are assessed using objective metrics while listening tests evaluate their ability to enhance the quality of parallel path processing techniques. Ultimately, an over-parameterized, BiasNet-based, all-pass model is proposed for the optimization problem under consideration, resulting in models that can estimate all-pass filter coefficients to align a dry signal with its affected, wet, equivalent.",
author = "Bargum, Anders R. and Stefania Serafin and Cumhur Erkut and Parker, \{Julian D.\}",
year = "2023",
publisher = "DAFx",
pages = "235--242",
booktitle = "Proceedings of the 26th International Conference on Digital Audio Effects (DAFx24)",issn = "2413-6700",
abstract = "Virtual analog (VA) audio effects are increasingly based on neural
networks and deep learning frameworks. Due to the underlying
black-box methodology, a successful model will learn to approximate the data it is presented, including potential errors such as
latency and audio dropouts as well as non-linear characteristics
and frequency-dependent phase shifts produced by the hardware.
The latter is of particular interest as the learned phase-response
might cause unwanted audible artifacts when the effect is used for
creative processing techniques such as dry-wet mixing or parallel
compression. To overcome these artifacts we propose differentiable signal processing tools and deep optimization structures for
automatically tuning all-pass filters to predict the phase response
of different VA simulations, and align processed signals that are
out of phase. The approaches are assessed using objective metrics while listening tests evaluate their ability to enhance the quality of parallel path processing techniques. Ultimately, an overparameterized, BiasNet-based, all-pass model is proposed for the
optimization problem under consideration, resulting in models that
can estimate all-pass filter coefficients to align a dry signal with its
affected, wet, equivalent.",
html = {https://vbn.aau.dk/ws/portalfiles/portal/593952137/DAFx23_paper_22.pdf}
}

@inproceedings{bargum2025exploring,
abbr={IEEE VR},
  title={Exploring the Impact of AI-Generated Speech on Avatar Perception and Realism in Virtual Reality Environments},
  author={Bargum, Anders R. and Hansen, Emil S{\o}nderskov and Erkut, Cumhur and Serafin, Stefania},
  booktitle={2025 IEEE Conference on Virtual Reality and 3D User Interfaces Abstracts and Workshops (VRW)},
  pages={647--652},
  year={2025},
  organization={IEEE},
  abstract = "The representation of avatars as virtual human characters plays a pivotal role in shaping key aspects of the user experience in virtual reality (VR), including immersion, social presence, and overall enjoyment. While prior research has predominantly focused on the impact of visual and behavioral realism on the perception of such avatars, the influence of synthetic speech on avatar realism, emotional communication, and social presence remains insufficiently explored, both in offline applications and for real-time scenarios. This study systematically compares various machine learning-based speech synthesis and voice conversion algorithms with human speech across neutral and emotional stimuli to evaluate how different AI-based synthetic speech methods affect user perceptions of avatars in VR. Building upon existing literature, the investigation seeks to examine the impact of nuanced variations in synthetic auditory stimuli, with consistent timbre and speaker identity, while exploring the use of a potentially real-time voice conversion algorithm in an ecologically valid VR setting. Our findings provide valuable insights into the interplay between AI, auditory realism and avatar presence, with broader implications for live social VR platforms, therapeutic interventions, and immersive environments.",
  html={https://ieeexplore-ieee-org.zorac.aub.aau.dk/document/10973025/}
}

@inproceedings{ai_i_sundhed,
abbr={FADL},
  author={Bargum, Anders R. and Lajboschitz, Simon and Shiraz, Farah and Saaby, Thomas N.},
  year= 2025, 
  title={Avatar Terapi: Når AI-og VR-teknologi giver stemme til det uhåndgribelige}, 
  editor = {A. Pihl, A. Dargahi, T. R. Savarimuthu}, 
  booktitle= {Kunstig Intelligens i Sundhed, FADL's Forlag A/S}, 
  publisher= {FADL's Forlag A/S},
  address= {København}, 
  abstract = "Kunstig intelligens (AI) er omkring os, i lommen på os, styrer store dele af vores opmærksomhed og liv. Det ændrer vores arbejdsmarked, vores adfærd, vores kommunikation og vores sundhed. Men hvor meget kan AI rent faktisk hjælpe os i sundhedsvæsenet? Hvordan kan teknologien konkret hjælpe patienter, sundhedspersonale og samfundet? Og hvordan gør den det allerede? Kunstig intelligens i sundhed giver et dybdegående indblik i brugen af AI i det danske sundhedsvæsen, med et virvar af lokale aktører, et snørklet offentligt sundhedsvæsen, store markedskræfter, og voldsom interesse fra patienter, udviklere og politikere. Ved at beskrive de mest prominente danske AI-løsninger giver forfatterne et billede af, hvordan en AI-løsning bliver til, hvilke udfordringer der kan være på vejen, og kommer med bud på sund og bæredygtig skalering og, hvordan vi opnår den bedste ressourcebesparelse med AI i sundhedsvæsenet.",
  html = {https://fadlforlag.dk/produkt/kunstig-intelligens-i-sundhed/}
}

@inproceedings{apsipa,
abbr={APSIPA},
  author={Bargum, Anders R. and Masuda, Naotake and Teleaga, Bogdan and Fyfe, Andrew and Erkut, Cumhur.},
  year= 2025, 
  month={Oct},
  video = {https://vimeo.com/1080172044?fl=pl&fe=sh},
  title={Unified Timbre Transfer: A Compact Model for Real-Time Multi-Instrument Sound Morphing}, 
  booktitle= {Asia Pacific Signal and Information Processing Association Annual Summit and Conference (APSIPA ASC)}, 
  abstract = "Recent advances in transformer-and diffusion-based
deep-generative models have significantly impacted the field of
music and audio synthesis. However, controllable and real-time
interactive models, such as those used for timbre transfer in
music production, remain largely dominated by auto-encoders
and generative adversarial networks. In pursuit of efficient and
flexible timbre morphing and multi-instrument timbre trans-
fer, we propose a simplified modeling approach, utilizing an
upsampled two-dimensional timbre space in conjunction with
engineered and instrument-dependent excitation signals. Different
from many other works, our model enables any-to-many timbre
transfer with added control over timbre, pitch, and loudness. We
additionally allow for seamless interpolation between instruments,
eliminating the need for separate model training. Our evaluation
shows performance comparable to specialized models, making it
highly relevant for the broader creative audio community.",
selected={true}
}
